{
  "name": "ultimate-flashcards",
  "version": "2.0.0",
  "description": "Ultimate Flashcards — generate duplex-ready flashcards from CSV or manual entry. Print double-sided with perfect alignment at ultimateflashcards.com.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "deploy": "npm run build && netlify deploy --prod --dir=dist"
  },
  "keywords": [
    "flashcards",
    "education",
    "pwa",
    "duplex-printing",
    "react",
    "catalyst"
  ],
  "author": "",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "clsx": "^2.1.1",
    "motion": "^12.40.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@vitejs/plugin-react": "^6.0.5",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^30.0.1",
    "tailwindcss": "^4.3.0",
    "vite": "^8.2.0",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^4.1.7"
  }
}
